<Project Sdk="Microsoft.NET.Sdk">
  <!--
    构建前设置环境变量：
      LGTS_GAME_DIR     游戏安装目录（包含 LGTS.exe）
      LGTS_BEPINEX_DIR  BepInEx 安装目录（默认 <LGTS_GAME_DIR>\BepInEx）
    也可以用 -p:GameDir=... 传入。
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- Windows 自带 .NET Framework 4.x 引用程序集路径，用于免 NuGet 离线编译 -->
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == ''">C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <OutputType>Library</OutputType>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LGTSChinese</AssemblyName>
    <RootNamespace>LGTSChinese</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>MSB3277;MSB3270;CS1701;CS1702;CS0618</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(LGTS_GAME_DIR)' != ''">$(LGTS_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Little Goody Two Shoes</GameDir>
    <ManagedDir>$(GameDir)\LGTS_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == '' and '$(LGTS_BEPINEX_DIR)' != ''">$(LGTS_BEPINEX_DIR)</BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <Target Name="CheckGameDir" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="找不到 $(ManagedDir)\Assembly-CSharp.dll。请设置环境变量 LGTS_GAME_DIR 指向游戏安装目录（包含 LGTS.exe）。" />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')"
           Text="找不到 $(BepInExDir)\core\BepInEx.dll。请先在游戏目录安装 BepInEx 5.4.x，或设置 LGTS_BEPINEX_DIR。" />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
